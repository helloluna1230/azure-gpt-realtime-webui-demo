# Azure OpenAI / Microsoft Foundry resource endpoint.
# Use either AZURE_OPENAI_ENDPOINT or AZURE_OPENAI_RESOURCE.
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com
AZURE_OPENAI_RESOURCE=

# Optional. If omitted, the server uses Microsoft Entra ID via DefaultAzureCredential.
# For Entra ID, run `az login` and assign Cognitive Services OpenAI User/Cognitive Services User role.
# Set AZURE_OPENAI_AUTH_MODE=entra to force Entra ID even when AZURE_OPENAI_API_KEY is present.
AZURE_OPENAI_AUTH_MODE=
AZURE_OPENAI_API_KEY=

# In Azure Realtime API, these values should be your deployment names.
AZURE_OPENAI_REALTIME2_DEPLOYMENT=gpt-realtime-2
AZURE_OPENAI_TRANSLATE_DEPLOYMENT=gpt-realtime-translate
AZURE_OPENAI_WHISPER_DEPLOYMENT=gpt-realtime-whisper

# Optional: use a separate Azure resource for Translate.
# Use this only if you intentionally want Translate to use a different resource/key.
# The server uses the minimal gpt-realtime-translate transcription-session payload.
AZURE_OPENAI_TRANSLATE_ENDPOINT=
AZURE_OPENAI_TRANSLATE_RESOURCE=
AZURE_OPENAI_TRANSLATE_API_KEY=

# Optional defaults.
AZURE_OPENAI_DEFAULT_VOICE=alloy
AZURE_OPENAI_REASONING_EFFORT=minimal
AZURE_OPENAI_INPUT_TRANSCRIPTION_MODEL=gpt-4o-transcribe

# Set to off if you want all standard Realtime data-channel events in the browser.
AZURE_OPENAI_WEBRTC_FILTER=on

# Optional stable, privacy-preserving user identifier for Realtime abuse monitoring.
OPENAI_SAFETY_IDENTIFIER=

PORT=3000
